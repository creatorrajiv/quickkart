# ─────────────────────────────────────────────────────────────────────
#  QuickKart environment variables
#
#  Copy this file to `.env` and fill in real values.
#  NEVER commit your `.env` (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────

# Required — Supabase project credentials
# (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key

# Optional — WhatsApp "Share Order" button on /cart
# International format, no '+' or spaces. Example for India: 91XXXXXXXXXX
VITE_WHATSAPP_BUSINESS_NUMBER=

# Optional — Browser push notifications (requires VAPID keys)
# Generate once: npx web-push generate-vapid-keys
# The PUBLIC key goes here. The PRIVATE key goes in Supabase Edge Function Secrets only.
VITE_VAPID_PUBLIC_KEY=

# Optional — Sentry error tracking
VITE_SENTRY_DSN=
